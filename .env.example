# ─────────────────────────────────────────────────────────────
# Ye News Bot — environment variables
# Copy this file to .env and fill in the values.
# ─────────────────────────────────────────────────────────────

# twitterapi.io — used for READING the watched accounts' tweets.
# Get your key at https://twitterapi.io (dashboard → API key).
TWITTERAPI_KEY=

# Official X API v2 — used for POSTING (OAuth 1.0a user-context keys).
# From developer.x.com: create an app with Read+Write, then generate these
# under Keys and tokens. See README for the exact steps.
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=

# OpenAI API key for the GPT rewriting. Get one at platform.openai.com/api-keys.
OPENAI_API_KEY=

# Supabase — project URL + service_role key (Settings → API).
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# ─────────────────────────────────────────────────────────────
# Optional tuning (sensible defaults are built in)
# ─────────────────────────────────────────────────────────────

# Accounts to watch (comma-separated handles, no @).
WATCH_ACCOUNTS=kanyewest,yeunrlsd,goodasssub,OnThatNoteTV,GhostTownYZY,yzyjohnny,TTVAuger,YE_TIMEZ

# How often to poll, in milliseconds. 30s keeps you well under the 1-minute goal.
POLL_INTERVAL_MS=30000

# When true, the bot logs what it WOULD post but does not actually post.
# Leave this true until you've watched the logs and are happy with the output.
DRY_RUN=true

# Ignore tweets older than this many seconds at startup, so a fresh deploy
# doesn't blast out a backlog of old news.
MAX_TWEET_AGE_SECONDS=300

# OpenAI model used to rewrite tweets. gpt-4o is a good default; gpt-4o-mini is
# cheaper, gpt-5 is higher quality.
REWRITE_MODEL=gpt-4o
